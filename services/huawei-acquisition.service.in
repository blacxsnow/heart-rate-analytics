[Unit]
Description=Huawei Band 9 heart-rate acquisition
Documentation=file://@REPO@/docs/17_acquisition_system.md
# The daemon retries if BlueZ is not ready, so no hard cross-manager dependency.
# Do not order this unit after default.target: both units are WantedBy it, and
# the web unit is After=acquisition, which creates an ordering cycle at boot.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@REPO@
Environment=BAND9_DATA_DIR=%h/.local/share/band9
Environment=PYTHONUNBUFFERED=1
ExecStart=@PYTHON@ -m fitness_band.acquisition.service
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
NoNewPrivileges=yes

[Install]
WantedBy=default.target
